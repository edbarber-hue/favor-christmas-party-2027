/*
 * Mystery Kris Kringle — game core.
 *
 * This one file is the "brain" of the game. It runs in two places:
 *   1. Inside Google Apps Script (copied into apps-script/Code.gs by tools/build.js)
 *   2. In the browser, for Demo Mode (no Google Sheet needed)
 *
 * It never touches storage directly: it gets a `db` adapter and a `hash` function.
 *   db.getPlayers()        -> [{id, name, pinHash, wishes:[{item, link}], mystery, alias, shopsFor, joinedAt}]
 *   db.savePlayers(list)
 *   db.getSettings()       -> {phase, budget, eventName, deadline, partyDate, adminPassword, salt}
 *   db.saveSettings(obj)
 *   db.getGame()           -> game object (see newGame) or null
 *   db.saveGame(game)
 *   db.getTrivia()         -> [{q, a}]
 *   hash(text)             -> string
 */
var KKCore = (function () {
  var PHASES = ['signup', 'drawn', 'revealed'];
  var MAX_WISHES = 5;
  var MIN_WISHES = 3;

  function fail(msg) { var e = new Error(msg); e.userFacing = true; throw e; }

  function clean(s, max) {
    return String(s == null ? '' : s).replace(/\s+/g, ' ').trim().slice(0, max || 200);
  }
  function key(name) { return clean(name, 60).toLowerCase(); }

  function cleanLink(s) {
    s = clean(s, 500);
    if (!s) return '';
    if (!/^https?:\/\//i.test(s)) s = 'https://' + s;
    return s;
  }

  function cleanWishes(wishes) {
    if (!Array.isArray(wishes)) fail('Please add your wishlist.');
    var out = [];
    for (var i = 0; i < wishes.length && out.length < MAX_WISHES; i++) {
      var w = wishes[i] || {};
      var item = clean(w.item, 140);
      if (item) out.push({ item: item, link: cleanLink(w.link) });
    }
    if (out.length < MIN_WISHES) fail('Please list at least ' + MIN_WISHES + ' gift ideas.');
    return out;
  }

  function checkPin(pin) {
    pin = String(pin == null ? '' : pin).trim();
    if (!/^\d{4}$/.test(pin)) fail('Your PIN must be exactly 4 digits.');
    return pin;
  }

  function pinHash(hash, settings, name, pin) {
    return hash((settings.salt || '') + '|' + key(name) + '|' + pin);
  }

  function findPlayer(players, name) {
    var k = key(name);
    for (var i = 0; i < players.length; i++) if (key(players[i].name) === k) return players[i];
    return null;
  }

  function login(db, hash, p) {
    var name = clean(p.name, 60);
    if (!name) fail('Please enter your name.');
    var pin = checkPin(p.pin);
    var players = db.getPlayers();
    var me = findPlayer(players, name);
    if (!me || me.pinHash !== pinHash(hash, db.getSettings(), name, pin)) {
      fail("That name and PIN don't match anyone. Check the spelling, or sign up first.");
    }
    return { me: me, players: players };
  }

  function byMystery(players, no) {
    for (var i = 0; i < players.length; i++) if (players[i].mystery === no) return players[i];
    return null;
  }

  function shuffle(arr, rand) {
    rand = rand || Math.random;
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(rand() * (i + 1));
      var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    }
    return arr;
  }

  function newGame(players) {
    var bags = players.map(function (p) { return { no: p.mystery, alias: p.alias || '', holder: '', steals: 0 }; })
      .sort(function (a, b) { return a.no - b.no; });
    return {
      bags: bags,
      scores: {},          // name -> correct answers this round
      target: 3,           // correct answers needed to pick a bag
      maxSteals: 2,        // a bag is locked after being stolen this many times
      holdersSitOut: true, // people holding a bag stop answering trivia
      resetEachRound: true,// everyone's score resets after a bag is picked
      qIndex: 0,
      showAnswer: false,
      log: [],
      updatedAt: 0
    };
  }

  function publicSettings(s, count) {
    return {
      phase: s.phase || 'signup',
      budget: s.budget || 500,
      eventName: s.eventName || 'Favor Christmas Party 2027',
      deadline: s.deadline || '',
      partyDate: s.partyDate || '',
      count: count
    };
  }

  function requireAdmin(db, p) {
    var s = db.getSettings();
    if (!s.adminPassword) fail('No organizer password is set yet. Add one in the Settings tab of the Google Sheet.');
    if (String(p.password || '') !== String(s.adminPassword)) fail('Wrong organizer password.');
    return s;
  }

  function meView(db, me, players, testMode) {
    var s = db.getSettings();
    var out = { name: me.name, wishes: me.wishes, settings: publicSettings(s, players.length), shoppingFor: null, testMode: !!testMode };
    if (s.phase !== 'signup' && me.shopsFor) {
      var target = byMystery(players, me.shopsFor);
      if (target) out.shoppingFor = { no: target.mystery, alias: target.alias || '', wishes: target.wishes };
    }
    if (s.phase === 'revealed' || testMode) { out.myMystery = me.mystery; out.myAlias = me.alias || ''; }
    return out;
  }

  var ops = {
    // ---------- Public ----------
    info: function (db) {
      return publicSettings(db.getSettings(), db.getPlayers().length);
    },

    join: function (db, hash, p) {
      var s = db.getSettings();
      var name = clean(p.name, 60);
      if (name.length < 2) fail('Please enter your name (as people at the party know you).');
      var pin = checkPin(p.pin);
      var wishes = cleanWishes(p.wishes);
      var players = db.getPlayers();
      var existing = findPlayer(players, name);
      if (existing) {
        if (existing.pinHash !== pinHash(hash, s, name, pin)) {
          fail('Someone already signed up as "' + existing.name + '". If that\'s you, use the PIN you chose. Otherwise add your last name or initial.');
        }
        if (s.phase === 'revealed') fail('The party is over — wishlists are locked.');
        existing.wishes = wishes;
        db.savePlayers(players);
        return { ok: true, updated: true, name: existing.name };
      }
      if (s.phase !== 'signup') fail('Sign-ups are closed — the names have already been drawn. Ask the organizer to reopen sign-ups.');
      players.push({
        id: 'p' + Date.now().toString(36) + Math.floor(Math.random() * 1e6).toString(36),
        name: name,
        pinHash: pinHash(hash, s, name, pin),
        wishes: wishes,
        mystery: 0,
        shopsFor: 0,
        joinedAt: new Date().toISOString()
      });
      db.savePlayers(players);
      return { ok: true, updated: false, name: name };
    },

    me: function (db, hash, p) {
      var r = login(db, hash, p);
      return meView(db, r.me, r.players, false);
    },

    // Organizer test mode: see anyone's page without their PIN
    viewAs: function (db, hash, p) {
      requireAdmin(db, p);
      var players = db.getPlayers(), me = null;
      players.forEach(function (x) { if (x.id === p.id) me = x; });
      if (!me) fail('Player not found.');
      return meView(db, me, players, true);
    },

    // Read-only party board for anyone's phone
    board: function (db) {
      var s = db.getSettings();
      var g = db.getGame();
      if (!g) return { phase: s.phase || 'signup', game: null };
      var trivia = db.getTrivia();
      var q = trivia[g.qIndex] || null;
      return {
        phase: s.phase,
        game: {
          bags: g.bags, scores: g.scores, target: g.target, maxSteals: g.maxSteals,
          log: (g.log || []).slice(-8), updatedAt: g.updatedAt,
          question: q ? { n: g.qIndex + 1, total: trivia.length, q: q.q, a: g.showAnswer ? q.a : '' } : null
        }
      };
    },

    reveal: function (db) {
      var s = db.getSettings();
      if (s.phase !== 'revealed') fail('No peeking! The reveal hasn\'t started yet.');
      var players = db.getPlayers();
      var list = [];
      for (var i = 0; i < players.length; i++) {
        var p = players[i];
        if (!p.mystery) continue;
        var giver = null;
        for (var j = 0; j < players.length; j++) if (players[j].shopsFor === p.mystery) giver = players[j].name;
        list.push({ no: p.mystery, alias: p.alias || '', name: p.name, giver: giver || '', wishes: p.wishes });
      }
      list.sort(function (a, b) { return a.no - b.no; });
      var g = db.getGame();
      if (g) list.forEach(function (r) { r.holder = (g.bags[r.no - 1] || {}).holder || ''; });
      return { eventName: s.eventName || 'Favor Christmas Party 2027', list: list };
    },

    // ---------- Organizer ----------
    adminCheck: function (db, hash, p) { requireAdmin(db, p); return { ok: true }; },

    adminList: function (db, hash, p) {
      var s = requireAdmin(db, p);
      var players = db.getPlayers();
      return {
        settings: publicSettings(s, players.length),
        players: players.map(function (x) {
          var target = x.shopsFor ? byMystery(players, x.shopsFor) : null;
          return {
            id: x.id, name: x.name, wishes: x.wishes, mystery: x.mystery, alias: x.alias || '',
            shopsFor: x.shopsFor, shopsForName: target ? target.name : '', joinedAt: x.joinedAt
          };
        })
      };
    },

    draw: function (db, hash, p, rand) {
      var s = requireAdmin(db, p);
      var players = db.getPlayers();
      if (players.length < 3) fail('You need at least 3 people to draw names.');
      // Random Mystery numbers 1..N
      var nums = shuffle(players.map(function (_, i) { return i + 1; }), rand);
      players.forEach(function (pl, i) { pl.mystery = nums[i]; });
      // Funny animal alias for every Mystery Person
      var pool = shuffle((typeof KK_ANIMALS !== 'undefined' ? KK_ANIMALS : []).slice(), rand);
      players.forEach(function (pl) { pl.alias = pool[pl.mystery - 1] || ('Mystery Critter #' + pl.mystery); });
      // One big random circle: each person shops for the next one, never themselves
      var circle = shuffle(players.slice(), rand);
      for (var i = 0; i < circle.length; i++) circle[i].shopsFor = circle[(i + 1) % circle.length].mystery;
      db.savePlayers(players);
      s.phase = 'drawn';
      db.saveSettings(s);
      var g = newGame(players);
      g.updatedAt = Date.now();
      db.saveGame(g);
      return { ok: true, count: players.length };
    },

    reopen: function (db, hash, p) {
      var s = requireAdmin(db, p);
      var players = db.getPlayers();
      players.forEach(function (pl) { pl.mystery = 0; pl.shopsFor = 0; pl.alias = ''; });
      db.savePlayers(players);
      s.phase = 'signup';
      db.saveSettings(s);
      db.saveGame(null);
      return { ok: true };
    },

    setPhase: function (db, hash, p) {
      var s = requireAdmin(db, p);
      if (PHASES.indexOf(p.phase) < 0) fail('Unknown phase.');
      if (p.phase !== 'signup' && !db.getPlayers().some(function (x) { return x.mystery; })) fail('Draw names first.');
      s.phase = p.phase;
      db.saveSettings(s);
      return { ok: true };
    },

    saveSettings: function (db, hash, p) {
      var s = requireAdmin(db, p);
      var v = p.values || {};
      if (v.eventName != null) s.eventName = clean(v.eventName, 80);
      if (v.budget != null) s.budget = Math.max(0, parseInt(v.budget, 10) || 0);
      if (v.deadline != null) s.deadline = clean(v.deadline, 40);
      if (v.partyDate != null) s.partyDate = clean(v.partyDate, 40);
      db.saveSettings(s);
      return { ok: true };
    },

    removePlayer: function (db, hash, p) {
      var s = requireAdmin(db, p);
      if (s.phase !== 'signup') fail('Reopen sign-ups before removing someone (this clears the draw).');
      var players = db.getPlayers().filter(function (x) { return x.id !== p.id; });
      db.savePlayers(players);
      return { ok: true };
    },

    resetPin: function (db, hash, p) {
      var s = requireAdmin(db, p);
      var pin = checkPin(p.pin);
      var players = db.getPlayers();
      var me = null;
      players.forEach(function (x) { if (x.id === p.id) me = x; });
      if (!me) fail('Player not found.');
      me.pinHash = pinHash(hash, s, me.name, pin);
      db.savePlayers(players);
      return { ok: true };
    },

    gameLoad: function (db, hash, p) {
      requireAdmin(db, p);
      var players = db.getPlayers();
      return {
        game: db.getGame(),
        trivia: db.getTrivia(),
        names: players.map(function (x) { return x.name; }).sort(),
        wishesByBag: players.filter(function (x) { return x.mystery; })
          .map(function (x) { return { no: x.mystery, alias: x.alias || '', wishes: x.wishes }; })
          .sort(function (a, b) { return a.no - b.no; })
      };
    },

    gameSave: function (db, hash, p) {
      requireAdmin(db, p);
      var g = p.game;
      if (!g || !Array.isArray(g.bags)) fail('Bad game data.');
      g.updatedAt = Date.now();
      if (g.log && g.log.length > 200) g.log = g.log.slice(-200);
      db.saveGame(g);
      return { ok: true, updatedAt: g.updatedAt };
    }
  };

  var PUBLIC = { info: 1, join: 1, me: 1, board: 1, reveal: 1 };

  function handle(db, hash, op, payload, rand) {
    try {
      if (!ops[op]) fail('Unknown request.');
      return { ok: true, data: ops[op](db, hash, payload || {}, rand) };
    } catch (e) {
      return { ok: false, error: e.userFacing ? e.message : ('Something went wrong: ' + e.message) };
    }
  }

  return { handle: handle, newGame: newGame, PUBLIC: PUBLIC, MAX_WISHES: MAX_WISHES, MIN_WISHES: MIN_WISHES };
})();


/* ===================== Google Sheet storage + web endpoint ===================== */

var SHEET_PLAYERS = 'Players';
var SHEET_SETTINGS = 'Settings';
var SHEET_TRIVIA = 'Trivia';
var PLAYER_HEADERS = ['Name', 'Mystery #', 'Animal name', 'Shops for Mystery #', 'Shops for (name)',
  'Wish 1', 'Wish 2', 'Wish 3', 'Wish 4', 'Wish 5', 'Joined', 'ID', 'PIN hash (do not edit)'];

function ss_() { return SpreadsheetApp.getActiveSpreadsheet(); }

function sheet_(name) {
  var sh = ss_().getSheetByName(name);
  if (!sh) throw new Error('Missing "' + name + '" tab. Run the setup function first.');
  return sh;
}

function wishToCell_(w) { return w ? (w.link ? w.item + '  |  ' + w.link : w.item) : ''; }
function cellToWish_(c) {
  c = String(c || '').trim();
  if (!c) return null;
  var i = c.lastIndexOf('|');
  if (i > 0 && /https?:\/\//.test(c.slice(i))) return { item: c.slice(0, i).trim(), link: c.slice(i + 1).trim() };
  return { item: c, link: '' };
}

var SheetDB = {
  getPlayers: function () {
    var sh = sheet_(SHEET_PLAYERS);
    var n = sh.getLastRow() - 1;
    if (n < 1) return [];
    return sh.getRange(2, 1, n, PLAYER_HEADERS.length).getValues()
      .filter(function (r) { return String(r[0]).trim() && r[11]; })
      .map(function (r) {
        var wishes = [];
        for (var i = 5; i <= 9; i++) { var w = cellToWish_(r[i]); if (w) wishes.push(w); }
        return {
          name: String(r[0]).trim(), mystery: Number(r[1]) || 0, alias: String(r[2] || ''), shopsFor: Number(r[3]) || 0,
          wishes: wishes, joinedAt: r[10] instanceof Date ? r[10].toISOString() : String(r[10]),
          id: String(r[11]), pinHash: String(r[12])
        };
      });
  },
  savePlayers: function (list) {
    var sh = sheet_(SHEET_PLAYERS);
    var byNo = {};
    list.forEach(function (p) { if (p.mystery) byNo[p.mystery] = p.name; });
    var rows = list.map(function (p) {
      var w = p.wishes || [];
      return [p.name, p.mystery || '', p.alias || '', p.shopsFor || '', p.shopsFor ? (byNo[p.shopsFor] || '') : '',
        wishToCell_(w[0]), wishToCell_(w[1]), wishToCell_(w[2]), wishToCell_(w[3]), wishToCell_(w[4]),
        p.joinedAt, p.id, p.pinHash];
    });
    var last = sh.getLastRow();
    if (last > 1) sh.getRange(2, 1, last - 1, PLAYER_HEADERS.length).clearContent();
    if (rows.length) sh.getRange(2, 1, rows.length, PLAYER_HEADERS.length).setValues(rows);
  },
  getSettings: function () {
    var vals = sheet_(SHEET_SETTINGS).getDataRange().getValues();
    var s = {};
    vals.forEach(function (r) { if (r[0]) s[String(r[0]).trim()] = r[1]; });
    return {
      phase: String(s.phase || 'signup'), budget: Number(s.budget) || 500,
      eventName: String(s.eventName || 'Favor Christmas Party 2027'),
      deadline: s.deadline instanceof Date ? Utilities.formatDate(s.deadline, Session.getScriptTimeZone(), 'MMM d, yyyy') : String(s.deadline || ''),
      partyDate: s.partyDate instanceof Date ? Utilities.formatDate(s.partyDate, Session.getScriptTimeZone(), 'MMM d, yyyy') : String(s.partyDate || ''),
      adminPassword: String(s.adminPassword || ''), salt: String(s.salt || '')
    };
  },
  saveSettings: function (s) {
    var sh = sheet_(SHEET_SETTINGS);
    var vals = sh.getDataRange().getValues();
    ['phase', 'budget', 'eventName', 'deadline', 'partyDate'].forEach(function (k) {
      var row = -1;
      for (var i = 0; i < vals.length; i++) if (String(vals[i][0]).trim() === k) row = i + 1;
      if (row < 0) { sh.appendRow([k, s[k]]); vals.push([k, s[k]]); }
      else sh.getRange(row, 2).setValue(s[k]);
    });
  },
  getGame: function () {
    var raw = PropertiesService.getScriptProperties().getProperty('GAME');
    return raw ? JSON.parse(raw) : null;
  },
  saveGame: function (g) {
    var props = PropertiesService.getScriptProperties();
    if (g) props.setProperty('GAME', JSON.stringify(g)); else props.deleteProperty('GAME');
  },
  getTrivia: function () {
    var sh = ss_().getSheetByName(SHEET_TRIVIA);
    if (!sh || sh.getLastRow() < 2) return KK_TRIVIA_SEED;
    return sh.getRange(2, 1, sh.getLastRow() - 1, 2).getValues()
      .filter(function (r) { return String(r[0]).trim(); })
      .map(function (r) { return { q: String(r[0]).trim(), a: String(r[1]).trim() }; });
  }
};

function sha256_(text) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8);
  return bytes.map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join('');
}

function respond_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function run_(op, payload) {
  // Reads don't need the lock; anything that might write does.
  if (op === 'info' || op === 'board' || op === 'reveal') return KKCore.handle(SheetDB, sha256_, op, payload);
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return { ok: false, error: 'The site is busy — please try again in a few seconds.' };
  try { return KKCore.handle(SheetDB, sha256_, op, payload); }
  finally { lock.releaseLock(); }
}

function doGet(e) {
  var p = (e && e.parameter) || {};
  return respond_(run_(p.op || 'info', p));
}

function doPost(e) {
  var body = {};
  try { body = JSON.parse(e.postData.contents || '{}'); } catch (err) { return respond_({ ok: false, error: 'Bad request.' }); }
  return respond_(run_(body.op, body.payload || {}));
}

/**
 * RUN THIS ONCE (select "setup" in the toolbar, then click Run).
 * It creates the Players, Settings and Trivia tabs.
 */
function setup() {
  var ss = ss_();
  var players = ss.getSheetByName(SHEET_PLAYERS) || ss.insertSheet(SHEET_PLAYERS);
  players.getRange(1, 1, 1, PLAYER_HEADERS.length).setValues([PLAYER_HEADERS])
    .setFontWeight('bold').setBackground('#0f3d2e').setFontColor('#ffffff');
  players.setFrozenRows(1);
  players.setColumnWidth(3, 240);
  players.setColumnWidths(6, 5, 220);

  var settings = ss.getSheetByName(SHEET_SETTINGS) || ss.insertSheet(SHEET_SETTINGS);
  if (settings.getLastRow() < 1) {
    settings.getRange(1, 1, 8, 3).setValues([
      ['Setting', 'Value', 'Notes'],
      ['adminPassword', 'change-me', 'Organizer password for the website. CHANGE THIS.'],
      ['eventName', 'Favor Christmas Party 2027', 'Shown at the top of the site'],
      ['budget', 500, 'Gift budget in pesos'],
      ['deadline', '', 'Sign-up deadline, e.g. Dec 1'],
      ['partyDate', '', 'Party date, e.g. Dec 19'],
      ['phase', 'signup', 'Managed by the website: signup / drawn / revealed'],
      ['salt', Utilities.getUuid(), 'Used to scramble PINs. Do not change after people sign up.']
    ]);
    settings.getRange(1, 1, 1, 3).setFontWeight('bold');
    settings.setColumnWidth(1, 140); settings.setColumnWidth(2, 260); settings.setColumnWidth(3, 380);
  }

  var trivia = ss.getSheetByName(SHEET_TRIVIA) || ss.insertSheet(SHEET_TRIVIA);
  if (trivia.getLastRow() < 2) {
    trivia.getRange(1, 1, 1, 2).setValues([['Question', 'Answer']]).setFontWeight('bold');
    trivia.getRange(2, 1, KK_TRIVIA_SEED.length, 2).setValues(KK_TRIVIA_SEED.map(function (t) { return [t.q, t.a]; }));
    trivia.setColumnWidth(1, 560); trivia.setColumnWidth(2, 260);
  }

  var first = ss.getSheets()[0];
  if (first.getName() === 'Sheet1' && first.getLastRow() === 0) ss.deleteSheet(first);
  SpreadsheetApp.getUi && SpreadsheetApp.getActive().toast('All set! Now change adminPassword in the Settings tab, then Deploy → New deployment.');
}
